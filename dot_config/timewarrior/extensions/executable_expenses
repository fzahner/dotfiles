#!/usr/bin/env python3
"""Timewarrior report: days with at least N hours tracked.

Usage:  timew expenses dfly :month
        timew expenses dfly :lastmonth
Threshold (default 6):  timew config reports.expenses.hours 6
"""
import json
import sys
from collections import defaultdict
from datetime import datetime, timedelta, timezone

config = {}
for line in sys.stdin:
    if not line.strip():
        break
    key, _, value = line.partition(":")
    config[key.strip()] = value.strip()
intervals = json.load(sys.stdin)

min_hours = float(config.get("reports.expenses.hours", 6))
tags = config.get("temp.report.tags", "")


def parse(ts):
    return datetime.strptime(ts, "%Y%m%dT%H%M%SZ").replace(tzinfo=timezone.utc).astimezone()


per_day = defaultdict(float)
for iv in intervals:
    start = parse(iv["start"])
    end = parse(iv["end"]) if "end" in iv else datetime.now().astimezone()
    # split at local midnight so overnight intervals count for the right day
    while start < end:
        midnight = (start + timedelta(days=1)).replace(hour=0, minute=0, second=0, microsecond=0)
        chunk_end = min(end, midnight)
        per_day[start.date()] += (chunk_end - start).total_seconds() / 3600
        start = chunk_end

days = sorted(d for d, h in per_day.items() if h >= min_hours)
label = f" on {tags}" if tags else ""
print(f"Days with >= {min_hours:g}h{label}: {len(days)}\n")
for d in days:
    hours, minutes = divmod(round(per_day[d] * 60), 60)
    print(f"  {d:%a %Y-%m-%d}  {hours}:{minutes:02d}")
