;; Control menu: opens in the top-right corner, toggled by the bar button.

(defpoll control :interval "2s"
  :initial '{"vol":0,"vol_muted":false,"bright":0,"wifi":false,"ssid":"","bt":false,"dnd":false,"osk":false,"player":"","title":"","artist":"","notifs":[],"calendar":{"title":"","weekdays":[],"weeks":[]}}'
  "~/.config/eww/control/scripts/status.sh")

(defvar control-open false)
(defvar calendar-offset 0)  ; months from now, see scripts/month.py
(defvar control-confirm "")  ; "reboot" / "poweroff" while asking for confirmation

(defwidget control-button []
  (button :class "control-button hover-effect ${control-open ? 'open' : ''}"
          :onclick "~/.config/eww/control/scripts/toggle.sh &"
    ""))

;; left click runs `action`, right click runs `right` (if given)
(defwidget control-toggle [on icon label action ?sub ?right]
  (button :class "control-toggle ${on ? 'on' : ''}"
          :onclick "~/.config/eww/control/scripts/action.sh ${action} &"
          :onrightclick {right == "" ? "" : "~/.config/eww/control/scripts/action.sh ${right} &"}
    (box :orientation "v" :space-evenly false :spacing 2 :halign "center" :valign "center"
      (label :class "control-toggle-icon" :halign "center" :text icon)
      (label :class "control-toggle-label" :halign "center" :text label)
      (label :class "control-toggle-sub" :halign "center" :limit-width 10
             :visible {sub != ""} :text sub))))

(defwidget control-slider [icon value action]
  (box :class "control-slider" :orientation "h" :space-evenly false
    (label :class "control-slider-icon" :text icon)
    (scale :hexpand true :min 0 :max 101 :value value
           :onchange "~/.config/eww/control/scripts/action.sh ${action} {}")
    (label :class "control-slider-value" :text "${value}%")))

(defwidget control-menu []
  (box :class "control-panel" :orientation "v" :space-evenly false :spacing 16
    (box :orientation "h" :spacing 8
      (control-toggle :on {control.wifi} :action "wlctl" :right "wifi" :label "Wi-Fi"
                      :icon {control.wifi ? "󰖩" : "󰖪"}
                      :sub {control.wifi ? control.ssid : ""})
      (control-toggle :on {control.bt} :action "blueman" :right "bt" :label "Bluetooth"
                      :icon {control.bt ? "󰂯" : "󰂲"})
      (control-toggle :on {control.dnd} :action "dnd" :label "Silent"
                      :icon {control.dnd ? "󰂛" : "󰂚"})
      (control-toggle :on {control.osk} :action "osk" :label "Keyboard" :icon "󰌌"))
    (box :orientation "v" :spacing 10
      (control-slider :icon {control.vol_muted ? "󰖁" : "󰕾"}
                      :value {control.vol} :action "volume")
      (control-slider :icon "󰃠" :value {control.bright} :action "bright"))
    (box :class "control-media" :orientation "v" :space-evenly false :spacing 6
         :visible {control.player != ""}
      (label :class "control-media-title" :xalign 0 :limit-width 30 :text {control.title})
      (label :class "control-media-artist" :xalign 0 :limit-width 34
             :visible {control.artist != ""} :text {control.artist})
      (box :orientation "h" :halign "center" :spacing 12
        (button :class "control-media-btn" :onclick "~/.config/eww/control/scripts/action.sh prev &" "󰒮")
        (button :class "control-media-btn" :onclick "~/.config/eww/control/scripts/action.sh play-pause &"
          {control.player == "Playing" ? "󰏤" : "󰐊"})
        (button :class "control-media-btn" :onclick "~/.config/eww/control/scripts/action.sh next &" "󰒭")))
    (box :class "control-power" :orientation "v" :space-evenly false :spacing 8
      (box :orientation "h" :spacing 8 :visible {control-confirm == ""}
        (button :class "control-power-btn" :tooltip "Lock" :onclick "~/.config/eww/control/scripts/action.sh lock &" "")
        (button :class "control-power-btn" :tooltip "Suspend" :onclick "~/.config/eww/control/scripts/action.sh suspend &" "󰤄")
        (button :class "control-power-btn" :tooltip "Restart" :onclick "eww update control-confirm=reboot" "")
        (button :class "control-power-btn" :tooltip "Shut down" :onclick "eww update control-confirm=poweroff" ""))
      (box :class "control-confirm" :orientation "h" :space-evenly false :spacing 8
           :visible {control-confirm != ""}
        (label :hexpand true :xalign 0
               :text {control-confirm == "reboot" ? "Restart now?" : "Shut down now?"})
        (button :class "control-confirm-btn yes" :onclick "~/.config/eww/control/scripts/action.sh ${control-confirm} &" "Yes")
        (button :class "control-confirm-btn" :onclick "eww update control-confirm=''" "Cancel")))
    (control-calendar)
    (control-notifications)))

(defwidget control-notifications []
  (box :class "control-notifs" :orientation "v" :space-evenly false :spacing 8
    (box :class "notifs-header" :orientation "h" :space-evenly false
      (label :class "notifs-title" :hexpand true :xalign 0
             :text "Notifications${arraylength(control.notifs) > 0 ? '  ' + arraylength(control.notifs) : ''}")
      (button :class "notifs-clear" :visible {arraylength(control.notifs) > 0}
              :onclick "~/.config/eww/control/scripts/action.sh notif-clear &" "Clear all"))
    ;; fixed height so the menu (and the windows docked next to it) keep their size
    (scroll :vscroll true :hscroll false :height 190
      (box :orientation "v" :space-evenly false :spacing 6
        (label :class "notifs-empty" :visible {arraylength(control.notifs) == 0}
               :text "No notifications")
        (for n in {control.notifs}
          (box :class "notif" :orientation "h" :space-evenly false :spacing 10
            (image :class "notif-icon" :visible {n.icon != ""} :valign "start"
                   :path {n.icon} :image-width 24 :image-height 24)
            (box :orientation "v" :space-evenly false :hexpand true
              (box :orientation "h" :space-evenly false
                (label :class "notif-app" :hexpand true :xalign 0 :limit-width 22 :text {n.app})
                (label :class "notif-ago" :text {n.ago}))
              (label :class "notif-summary" :xalign 0 :limit-width 30 :text {n.summary})
              (label :class "notif-body" :xalign 0 :wrap true :limit-width 90
                     :visible {n.body != "" && n.body != n.summary} :text {n.body}))
            (button :class "notif-close" :valign "start"
                    :onclick "~/.config/eww/control/scripts/action.sh notif-rm ${n.id} &" "")))))))

;; Own calendar instead of GTK's, whose day numbers can't be centered in their cells
(defwidget control-calendar []
  (box :class "control-calendar" :orientation "v" :space-evenly false :spacing 4
    (box :class "calendar-header" :orientation "h" :space-evenly false
      (button :class "calendar-nav" :onclick "~/.config/eww/control/scripts/month.py -1 &" "")
      (button :class "calendar-title" :hexpand true :tooltip "Back to today"
              :onclick "~/.config/eww/control/scripts/month.py reset &"
        {control.calendar.title})
      (button :class "calendar-nav" :onclick "~/.config/eww/control/scripts/month.py +1 &" ""))
    (box :class "calendar-weekdays" :orientation "h"
      (for name in {control.calendar.weekdays}
        (label :class "calendar-weekday" :text name)))
    (for week in {control.calendar.weeks}
      (box :orientation "h"
        (for day in week
          (box :class "calendar-day ${day.class}" :halign "center" :valign "center"
            (label :halign "center" :valign "center" :hexpand true :vexpand true
                   :text {day.day})))))))

(defwindow control
  :monitor 0
  :windowtype "dock"
  :wm-ignore true
  :stacking "fg"
  :geometry (geometry :x "0px"
                      :y "54px"
                      :width "340px"
                      :height "10px"
                      :anchor "top right")
  (box :halign "end" :valign "start"
    (control-menu)))
