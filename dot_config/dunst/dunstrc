[global]
    monitor = 0
    scale = 1.5
    frame_width = 1
    separator_color = frame
    corner_radius = 0
    corners = top,bottom
    offset = 15x50
    gap_size = 1
    format = "<b>󰁕 %a</b>\n%s\n<i>%b</i>"
    highlight = "#a7c080"
    # Tells Dunst to use rofi in dmenu mode to display notification actions
    dmenu = /usr/bin/rofi -dmenu -p Dunst
    mouse_left_click = context, close_current
    mouse_right_click = close_current

[urgency_low]
    background = "#2d353b"
    foreground = "#9da9a0"
    frame_color = "#9da9a0"
    default_icon = "~/.config/dunst/icons/bell-badge-low.svg"

[urgency_normal]
    background = "#2d353b"
    foreground = "#d3c6aa"
    frame_color = "#d3c6aa"
    default_icon = "~/.config/dunst/icons/bell-badge.svg"

[urgency_critical]
    background = "#2d353b"
    foreground = "#e67e80"
    frame_color = "#e67e80"
    default_icon = "~/.config/dunst/icons/alert-decagram.svg"
